# Copy to .env and fill in. Never commit real secrets.

# Offline mode: 1 = recorded LLM fixtures, no network/keys (used by CI + tests)
OFFLINE=1

# Database (Postgres + pgvector)
DATABASE_URL=postgresql+psycopg://clearance:clearance@localhost:5432/clearance

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM model tiers (LiteLLM model strings)
MODEL_SMALL=gemini/gemini-3.1-flash-lite
MODEL_STRONG=gemini/gemini-3.8-flash
MODEL_JUDGE=gemini/gemini-3.1-flash-lite

# LLM provider keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Auth — Clerk
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# Tracing — Langfuse / Phoenix via OTLP
OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=clearance-prior-auth

# Payer service
PAYER_BASE_URL=http://localhost:8081

# LLM budget ceiling per run (USD)
BUDGET_USD_MAX=0.10
